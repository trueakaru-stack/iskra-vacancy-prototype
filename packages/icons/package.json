{
  "name": "@neobook/icons",
  "version": "0.4.0",
  "description": "Иконки NeoBook — курированный набор из витрины дизайн-системы.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "svg",
    "meta.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./svg/*": "./svg/*",
    "./meta.json": "./meta.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-icons.mjs && vite build && tsc -b",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@neobook/vite-config": "workspace:*",
    "@types/react": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "@vanilla-extract/css": "catalog:"
  }
}
