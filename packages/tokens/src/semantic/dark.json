{
  "$description": "Уровень 2 — семантика, тёмная тема. Форма ОБЯЗАНА совпадать со светлой один в один: генератор падает, если появился лишний или пропал существующий ключ.",
  "bg": {
    "canvas": {
      "$value": "{color.neutral.950}",
      "$type": "color"
    },
    "surface": {
      "$value": "{color.neutral.900}",
      "$type": "color"
    },
    "subtle": {
      "$value": "{color.neutral.850}",
      "$type": "color"
    },
    "muted": {
      "$value": "{color.neutral.800}",
      "$type": "color"
    },
    "hover": {
      "$value": "{color.neutral.800}",
      "$type": "color"
    },
    "active": {
      "$value": "{color.neutral.700}",
      "$type": "color"
    },
    "inverse": {
      "$value": "{color.neutral.50}",
      "$type": "color"
    }
  },
  "border": {
    "subtle": {
      "$value": "{color.neutral.850}",
      "$type": "color"
    },
    "default": {
      "$value": "{color.neutral.800}",
      "$type": "color"
    },
    "strong": {
      "$value": "{color.neutral.700}",
      "$type": "color"
    },
    "focus": {
      "$value": "{color.primary.400}",
      "$type": "color"
    }
  },
  "fg": {
    "default": {
      "$value": "{color.neutral.50}",
      "$type": "color"
    },
    "secondary": {
      "$value": "{color.neutral.300}",
      "$type": "color"
    },
    "muted": {
      "$value": "{color.neutral.400}",
      "$type": "color"
    },
    "disabled": {
      "$value": "{color.neutral.600}",
      "$type": "color"
    },
    "inverse": {
      "$value": "{color.neutral.900}",
      "$type": "color"
    },
    "onPrimary": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "onAccent": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "onDanger": {
      "$value": "#ffffff",
      "$type": "color"
    }
  },
  "action": {
    "primary": {
      "bg": {
        "$value": "{color.primary.500}",
        "$type": "color"
      },
      "bgHover": {
        "$value": "{color.primary.400}",
        "$type": "color"
      },
      "bgActive": {
        "$value": "{color.primary.300}",
        "$type": "color"
      },
      "bgSubtle": {
        "$value": "color-mix(in srgb, {action.primary.bg} 16%, transparent)",
        "$type": "color",
        "$description": "В макетах — rgba(120, 71, 245, 0.16): заливка action.primary.bg (primary-500) на 16%. Записано ссылкой, чтобы подложка следовала за брендом в теме потребителя; значение то же. То же у border ниже (40%) и у пары accent."
      },
      "fg": {
        "$value": "{color.primary.300}",
        "$type": "color"
      },
      "fgActive": {
        "$value": "{color.primary.200}",
        "$type": "color"
      },
      "border": {
        "$value": "color-mix(in srgb, {action.primary.bg} 40%, transparent)",
        "$type": "color"
      }
    },
    "accent": {
      "bg": {
        "$value": "{color.accent.500}",
        "$type": "color"
      },
      "bgHover": {
        "$value": "{color.accent.400}",
        "$type": "color"
      },
      "bgActive": {
        "$value": "{color.accent.300}",
        "$type": "color"
      },
      "bgSubtle": {
        "$value": "color-mix(in srgb, {action.accent.bg} 14%, transparent)",
        "$type": "color"
      },
      "fg": {
        "$value": "{color.accent.300}",
        "$type": "color"
      },
      "border": {
        "$value": "color-mix(in srgb, {action.accent.bg} 40%, transparent)",
        "$type": "color"
      }
    },
    "danger": {
      "bg": {
        "$value": "{color.negative.500}",
        "$type": "color"
      },
      "bgHover": {
        "$value": "color-mix(in srgb, {color.negative.500} 88%, black)",
        "$type": "color"
      },
      "bgActive": {
        "$value": "color-mix(in srgb, {color.negative.500} 78%, black)",
        "$type": "color"
      },
      "bgSubtle": {
        "$value": "rgba(239, 69, 97, 0.16)",
        "$type": "color"
      },
      "fg": {
        "$value": "{color.negative.400}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.negative.500}",
        "$type": "color"
      }
    }
  },
  "status": {
    "$description": "Тёмная тема в макетах переопределяет только фоны (--pos-100 и соседние). Сами --pos-500 и --neg-500 остаются теми же, что в светлой, поэтому здесь 500, а не 400.",
    "positive": {
      "fg": {
        "$value": "{color.positive.500}",
        "$type": "color"
      },
      "bgSubtle": {
        "$value": "rgba(45, 193, 135, 0.16)",
        "$type": "color"
      }
    },
    "negative": {
      "fg": {
        "$value": "{color.negative.500}",
        "$type": "color"
      },
      "bgSubtle": {
        "$value": "rgba(239, 69, 97, 0.16)",
        "$type": "color"
      }
    },
    "warning": {
      "fg": {
        "$value": "{color.warning.500}",
        "$type": "color"
      },
      "bgSubtle": {
        "$value": "rgba(212, 144, 24, 0.16)",
        "$type": "color"
      }
    },
    "info": {
      "fg": {
        "$value": "{color.info.500}",
        "$type": "color"
      },
      "bgSubtle": {
        "$value": "rgba(35, 112, 217, 0.16)",
        "$type": "color"
      }
    }
  },
  "trend": {
    "$description": "Значения приходят из тех же --pos-500 и --neg-500, что и status: в тёмной теме макеты их не переопределяют.",
    "up": {
      "fg": {
        "$value": "{color.positive.500}",
        "$type": "color"
      },
      "bgSubtle": {
        "$value": "rgba(45, 193, 135, 0.16)",
        "$type": "color"
      }
    },
    "down": {
      "fg": {
        "$value": "{color.negative.500}",
        "$type": "color"
      },
      "bgSubtle": {
        "$value": "rgba(239, 69, 97, 0.16)",
        "$type": "color"
      }
    },
    "flat": {
      "fg": {
        "$value": "{color.neutral.400}",
        "$type": "color"
      },
      "bgSubtle": {
        "$value": "{color.neutral.800}",
        "$type": "color"
      }
    }
  },
  "shadow": {
    "xs": {
      "$value": "0 1px 2px rgba(0, 0, 0, 0.4)",
      "$type": "shadow"
    },
    "sm": {
      "$value": "0 1px 2px rgba(0, 0, 0, 0.5), 0 1px 3px rgba(0, 0, 0, 0.4)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 2px 4px rgba(0, 0, 0, 0.5), 0 4px 8px rgba(0, 0, 0, 0.5)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 4px 8px rgba(0, 0, 0, 0.6), 0 12px 24px rgba(0, 0, 0, 0.5)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 8px 16px rgba(0, 0, 0, 0.7), 0 24px 48px rgba(0, 0, 0, 0.6)",
      "$type": "shadow"
    },
    "switchKnob": {
      "$value": "0 1px 2px rgba(0, 0, 0, 0.2)",
      "$type": "shadow",
      "$description": "То же значение, что в светлой теме: в макетах тень кружка задана в самом компоненте и темой не подменяется."
    }
  },
  "focus": {
    "ring": {
      "$value": "0 0 0 3px color-mix(in srgb, {border.focus} 40%, transparent)",
      "$type": "shadow",
      "$description": "В макетах — rgba(150, 112, 255, 0.40), то есть border.focus тёмной темы (primary-400) на 40%. Записано ссылкой, чтобы кольцо следовало за border.focus в теме потребителя; значение то же."
    },
    "ringDanger": {
      "$value": "0 0 0 3px rgba(217, 48, 74, 0.25)",
      "$type": "shadow"
    }
  },
  "avatar": {
    "$description": "Тёмная тема палитры аватаров. Из reference: фон — 26% акцентного цвета поверх живого {bg.surface} (следует за кастомной темой потребителя), текст — осветлённый акцент. color-mix статически не считается, поэтому в отчёт по контрасту эти пары не попадают.",
    "c1": {
      "bg": { "$value": "color-mix(in srgb, #6028d9 26%, {bg.surface})", "$type": "color" },
      "fg": { "$value": "color-mix(in srgb, #b69cff 90%, white)", "$type": "color" }
    },
    "c2": {
      "bg": { "$value": "color-mix(in srgb, #167a4e 26%, {bg.surface})", "$type": "color" },
      "fg": { "$value": "color-mix(in srgb, #2dc187 90%, white)", "$type": "color" }
    },
    "c3": {
      "bg": { "$value": "color-mix(in srgb, #1d5fc4 26%, {bg.surface})", "$type": "color" },
      "fg": { "$value": "color-mix(in srgb, #6ba3ef 90%, white)", "$type": "color" }
    },
    "c4": {
      "bg": { "$value": "color-mix(in srgb, #8a5e08 26%, {bg.surface})", "$type": "color" },
      "fg": { "$value": "color-mix(in srgb, #e6b555 90%, white)", "$type": "color" }
    },
    "c5": {
      "bg": { "$value": "color-mix(in srgb, #963480 26%, {bg.surface})", "$type": "color" },
      "fg": { "$value": "color-mix(in srgb, #e08cc9 90%, white)", "$type": "color" }
    },
    "statusOffline": {
      "$value": "{color.neutral.400}",
      "$type": "color",
      "$description": "То же значение, что в светлой теме: в макетах точка задана примитивом и темой не подменяется."
    }
  },
  "settings": {
    "$description": "Тёмная тема «опасной зоны» настроек. Формулы те же: доли непереворачиваемого {color.negative.500} поверх прозрачного, поэтому значения совпадают со светлой темой — смешивание идёт с фоном карточки на лету.",
    "dangerBorder": { "$value": "color-mix(in srgb, {color.negative.500} 30%, transparent)", "$type": "color" },
    "dangerHeadBorder": { "$value": "color-mix(in srgb, {color.negative.500} 18%, transparent)", "$type": "color" }
  },
  "dialog": {
    "$description": "Тёмная тема цветов диалога. Формулы те же: ссылки {fg.default} и {bg.surface} разрешаются в значения тёмной темы.",
    "backdropBg": { "$value": "color-mix(in srgb, {fg.default} 42%, transparent)", "$type": "color" },
    "icon": {
      "dangerBg": { "$value": "color-mix(in srgb, {color.negative.500} 12%, {bg.surface})", "$type": "color" },
      "warningBg": { "$value": "color-mix(in srgb, {color.warning.500} 14%, {bg.surface})", "$type": "color" },
      "infoBg": { "$value": "color-mix(in srgb, {color.info.500} 12%, {bg.surface})", "$type": "color" },
      "positiveBg": { "$value": "color-mix(in srgb, {color.positive.500} 12%, {bg.surface})", "$type": "color" }
    }
  },
  "tabs": {
    "$description": "Тёмная тема цветов вкладок. Значение то же: в макетах у этого бейджа нет темнотемного переопределения, подложка обеих тем — action.primary.bg.",
    "pillActiveBadgeBg": { "$value": "rgba(255, 255, 255, 0.22)", "$type": "color" }
  },
  "banner": {
    "$description": "Тёмная тема рамки баннера. Формулы те же: в макетах тёмная тема переопределяет только фоны (--info-100 и соседние), сами --info-500 и --pos-500 остаются светлотемными. Замер в витрине подтверждает: рамка info в обеих темах — srgb(0.137 0.439 0.851 / 0.32).",
    "border": {
      "info":     { "$value": "color-mix(in srgb, {color.info.500} 32%, transparent)",     "$type": "color" },
      "positive": { "$value": "color-mix(in srgb, {color.positive.500} 32%, transparent)", "$type": "color" },
      "warning":  { "$value": "color-mix(in srgb, {color.warning.500} 32%, transparent)",  "$type": "color" },
      "negative": { "$value": "color-mix(in srgb, {color.negative.500} 32%, transparent)", "$type": "color" }
    }
  },
  "timeline": {
    "$description": "Тёмная тема цветов маркера ленты событий. Формулы те же: в макетах тёмная тема переопределяет только сотые ступени статусных цветов, сами --pos-500 и --info-500 остаются светлотемными, а ссылка {bg.surface} в подложке разрешается в тёмный neutral-900 сама.",
    "markerBorder": {
      "positive": { "$value": "color-mix(in srgb, {color.positive.500} 35%, transparent)", "$type": "color" },
      "negative": { "$value": "color-mix(in srgb, {color.negative.500} 35%, transparent)", "$type": "color" },
      "warning":  { "$value": "color-mix(in srgb, {color.warning.500} 35%, transparent)",  "$type": "color" },
      "info":     { "$value": "color-mix(in srgb, {color.info.500} 35%, transparent)",     "$type": "color" },
      "primary":  { "$value": "color-mix(in srgb, {color.primary.500} 35%, transparent)",  "$type": "color" }
    },
    "markerBg": {
      "positive": { "$value": "color-mix(in srgb, {color.positive.500} 12%, {bg.surface})", "$type": "color" },
      "negative": { "$value": "color-mix(in srgb, {color.negative.500} 12%, {bg.surface})", "$type": "color" },
      "warning":  { "$value": "color-mix(in srgb, {color.warning.500} 12%, {bg.surface})",  "$type": "color" },
      "info":     { "$value": "color-mix(in srgb, {color.info.500} 12%, {bg.surface})",     "$type": "color" }
    }
  },

  "kpi": {
    "$description": "Тёмная тема парадной карточки показателя. Значения те же, что в светлой: в макетах у .kpi--featured нет тёмного переопределения — карточка тёмная сама по себе, темой она не управляется. Токены продублированы, а не опущены, потому что контракт требует полного набора в обеих темах.",
    "featuredBgFrom": { "$value": "{color.primary.900}", "$type": "color" },
    "featuredBgTo": { "$value": "{color.neutral.1000}", "$type": "color" },
    "featuredFg": { "$value": "{color.neutral.0}", "$type": "color" },
    "featuredFgMuted": { "$value": "color-mix(in srgb, {color.neutral.0} 65%, transparent)", "$type": "color" },
    "featuredSparkStroke": { "$value": "{color.primary.300}", "$type": "color" },
    "featuredDeltaPositiveFg": { "$value": "{color.positive.400}", "$type": "color" },
    "featuredDeltaPositiveBg": { "$value": "color-mix(in srgb, {color.positive.400} 18%, transparent)", "$type": "color" }
  },
  "progress": {
    "$description": "Тёмная тема штриховки прогресса. Значение то же, что в светлой: в макетах у .progress__fill--striped тёмного переопределения нет — светлый штрих ложится поверх насыщенной заливки и в обеих темах читается одинаково. Токен продублирован, а не опущен, потому что контракт требует полного набора в обеих темах.",
    "stripe": { "$value": "rgba(255, 255, 255, 0.22)", "$type": "color" },
    "fillNeutral": {
      "$value": "{color.neutral.400}",
      "$type": "color",
      "$description": "То же значение, что в светлой теме: в макетах заливка задана примитивом и темой не подменяется."
    }
  },
  "sidebar": {
    "$description": "Тёмная тема цветов карточки-призыва. Формулы те же: в макетах у .sidenav__cta тёмного переопределения нет, ссылка {bg.surface} разрешается в тёмную поверхность сама, а --primary-500 и --accent-500 в обеих темах одни и те же.",
    "ctaBgFrom": {
      "$value": "color-mix(in srgb, {color.primary.500} 14%, {bg.surface})",
      "$type": "color"
    },
    "ctaBgTo": {
      "$value": "color-mix(in srgb, {color.accent.500} 12%, {bg.surface})",
      "$type": "color"
    },
    "ctaBorder": {
      "$value": "color-mix(in srgb, {color.primary.500} 22%, transparent)",
      "$type": "color"
    },
    "tooltipBg": {
      "$value": "{color.neutral.800}",
      "$type": "color",
      "$description": "То же значение, что в светлой теме: подсказка рельса тёмная в обеих."
    },
    "tooltipFg": {
      "$value": "{color.neutral.0}",
      "$type": "color"
    }
  },
  "badge": {
    "$description": "То же значение, что в светлой теме: сплошной бейдж тёмный в обеих.",
    "solidBg": {
      "$value": "{color.neutral.800}",
      "$type": "color"
    },
    "solidFg": {
      "$value": "#ffffff",
      "$type": "color"
    }
  },
  "upload": {
    "borderHover": {
      "$value": "{color.primary.400}",
      "$type": "color",
      "$description": "То же значение, что в светлой теме: в макетах рамка задана примитивом и темой не подменяется."
    }
  },
  "objectCard": {
    "errorBorder": {
      "$value": "{color.negative.400}",
      "$type": "color",
      "$description": "То же значение, что в светлой теме: в макетах рамка задана примитивом и темой не подменяется."
