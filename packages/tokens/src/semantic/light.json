{
  "bg": {
    "surface": {
      "$value": "oklch(100% 0 0)",
      "$type": "color",
      "$description": "Карточки, панели, поповеры"
    },
    "subtle": {
      "$value": "oklch(97% 0 0)",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(97% 0 0)",
      "$type": "color"
    },
    "hover": {
      "$value": "oklch(97% 0 0)",
      "$type": "color"
    },
    "active": {
      "$value": "{color.neutral.150}",
      "$type": "color"
    },
    "inverse": {
      "$value": "{color.neutral.900}",
      "$type": "color"
    }
  },
  "border": {
    "subtle": {
      "$value": "#d6d6e2",
      "$type": "color"
    },
    "default": {
      "$value": "#d6d6e2",
      "$type": "color"
    },
    "strong": {
      "$value": "#b6b6c6",
      "$type": "color"
    },
    "focus": {
      "$value": "oklch(70.8% 0 0)",
      "$type": "color"
    }
  },
  "fg": {
    "default": {
      "$value": "oklch(14.5% 0 0)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(45% 0 0)",
      "$type": "color"
    },
    "muted": {
      "$value": "oklch(55.6% 0 0)",
      "$type": "color"
    },
    "disabled": {
      "$value": "{color.neutral.400}",
      "$type": "color"
    },
    "inverse": {
      "$value": "{color.neutral.0}",
      "$type": "color"
    },
    "onPrimary": {
      "$value": "oklch(98.5% 0 0)",
      "$type": "color",
      "$description": "Текст поверх action.primary.bg — не меняется темой"
    },
    "onDanger": {
      "$value": "#ffffff",
      "$type": "color"
    }
  },
  "action": {
    "primary": {
      "bg": {
        "$value": "oklch(20.5% 0 0)",
        "$type": "color"
      },
      "bgHover": {
        "$value": "oklch(36% 0 0)",
        "$type": "color"
      },
      "bgActive": {
        "$value": "oklch(14.5% 0 0)",
        "$type": "color"
      },
      "bgSubtle": {
        "$value": "{color.primary.50}",
        "$type": "color"
      },
      "fg": {
        "$value": "oklch(20.5% 0 0)",
        "$type": "color"
      }
    },
    "accent": {
      "bg": {
        "$value": "{color.accent.500}",
        "$type": "color"
      }
    },
    "danger": {
      "bg": {
        "$value": "{color.negative.500}",
        "$type": "color"
      }
    }
  },
  "status": {
    "positive": {
      "fg": {
        "$value": "{color.positive.500}",
        "$type": "color"
      }
    },
    "negative": {
      "fg": {
        "$value": "{color.negative.500}",
        "$type": "color"
      }
    },
    "warning": {
      "fg": {
        "$value": "{color.warning.500}",
        "$type": "color"
      }
    },
    "info": {
      "fg": {
        "$value": "{color.info.500}",
        "$type": "color"
      }
    }
  },
  "trend": {
    "up": {
      "fg": {
        "$value": "{color.positive.500}",
        "$type": "color"
      }
    },
    "down": {
      "fg": {
        "$value": "{color.negative.500}",
        "$type": "color"
      }
    }
  },
  "shadow": {
    "md": {
      "$value": "0 2px 4px rgba(16, 16, 35, 0.06), 0 4px 8px rgba(16, 16, 35, 0.06)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 4px 8px rgba(16, 16, 35, 0.08), 0 12px 24px rgba(16, 16, 35, 0.08)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 8px 16px rgba(16, 16, 35, 0.10), 0 24px 48px rgba(16, 16, 35, 0.12)",
      "$type": "shadow"
    }
  },
  "focus": {
    "ring": {
      "$value": "0 0 0 3px color-mix(in srgb, {border.focus} 30%, transparent)",
      "$type": "shadow",
      "$description": "Кольцо фокуса. В макетах — rgba(120, 71, 245, 0.30), то есть border.focus (primary-500) на 30%. Записано ссылкой, а не литералом, чтобы кольцо следовало за border.focus в теме потребителя; значение то же."
    },
    "ringDanger": {
      "$value": "0 0 0 3px rgba(217, 48, 74, 0.25)",
      "$type": "shadow",
      "$description": "Кольцо фокуса на невалидном поле. Значение из reference: .input.is-invalid:focus. Вынесено в токен, чтобы в компонентах не оставалось литералов."
    }
  },
  "avatar": {
    "c1": {
      "bg": {
        "$value": "#efe1ff",
        "$type": "color"
      },
      "fg": {
        "$value": "#6028d9",
        "$type": "color"
      }
    },
    "c2": {
      "bg": {
        "$value": "#d9f5ec",
        "$type": "color"
      },
      "fg": {
        "$value": "#167a4e",
        "$type": "color"
      }
    },
    "c3": {
      "bg": {
        "$value": "#e0ecff",
        "$type": "color"
      },
      "fg": {
        "$value": "#1d5fc4",
        "$type": "color"
      }
    },
    "c4": {
      "bg": {
        "$value": "#fbecc6",
        "$type": "color"
      },
      "fg": {
        "$value": "#8a5e08",
        "$type": "color"
      }
    },
    "c5": {
      "bg": {
        "$value": "#f8d9ec",
        "$type": "color"
      },
      "fg": {
        "$value": "#963480",
        "$type": "color"
      }
    },
    "statusOffline": {
      "$value": "{color.neutral.400}",
      "$type": "color",
      "$description": "Точка статуса «не в сети». Из reference (.avatar__status--offline): --neutral-400 в обеих темах. Статусы «в сети» и «занят» берут status.positive.fg и status.warning.fg — у них те же значения, отдельные токены не нужны."
    }
  },
  "dialog": {
    "backdropBg": {
      "$value": "color-mix(in srgb, {fg.default} 42%, transparent)",
      "$type": "color"
    }
  },
  "progress": {
    "fillNeutral": {
      "$value": "{color.neutral.400}",
      "$type": "color",
      "$description": "Заливка нейтрального варианта полосы и кольца прогресса. Из reference (.progress--neutral .progress__fill, .ring--neutral .ring__fill): --neutral-400 в обеих темах. Остальные варианты берут готовые action.*.bg и status.*.fg — значения совпадают."
    }
  }
}
