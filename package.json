{
  "name": "iskra-vacancy-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build:design-system": "pnpm --filter @neobook/tokens build && pnpm --filter @neobook/icons build && pnpm --filter @neobook/i18n build",
    "build": "pnpm run build:design-system && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@neobook/i18n": "workspace:*",
    "@neobook/icons": "workspace:*",
    "@neobook/react": "workspace:*",
    "@neobook/tokens": "workspace:*",
    "lucide-react": "1.25.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "27.0.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
